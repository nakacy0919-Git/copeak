{
  "id": "L10-021",
  "category_id": "L10",
  "title": "A Lesson Without the Answer Key",
  "title_ja": "解答のない授業",
  "level_id": "eiken-pre2",
  "status": "draft",
  "original": true,
  "word_count": 343,
