{
  "id": "L08-020",
  "category_id": "L08",
  "title": "The Exhibition with an Empty Frame",
  "title_ja": "空の額縁のある展覧会",
  "level_id": "eiken-pre2",
  "status": "draft",
  "original": true,
  "word_count": 322,
  "source_links": [
