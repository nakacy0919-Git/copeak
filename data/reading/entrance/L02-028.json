{
  "id": "L02-028",
  "category_id": "L02",
  "title": "The Date on the Photograph",
  "title_ja": "写真に書かれた日付",
  "level_id": "eiken-pre2",
  "status": "draft",
  "original": true,
  "word_count": 283,
