{
  "id": "L05-022",
  "category_id": "L05",
  "title": "A Translation with Two Audiences",
  "title_ja": "二つの読者を持つ翻訳",
  "level_id": "eiken-2",
  "status": "draft",
  "original": true,
  "word_count": 358,
