{
  "id": "L04-020",
  "category_id": "L04",
  "title": "The Cost of Being the Person Who Always Helps",
  "title_ja": "いつも助ける人になることの負担",
  "level_id": "eiken-pre2",
  "status": "draft",
  "original": true,
