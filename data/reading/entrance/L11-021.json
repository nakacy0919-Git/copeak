{
  "id": "L11-021",
  "category_id": "L11",
  "title": "A Hearing for the People Who Were Absent",
  "title_ja": "欠席者のための公聴会",
  "level_id": "eiken-pre2",
  "status": "draft",
  "original": true,
  "word_count": 331,
  "source_links": [
